{
  "ReverseProxy": {
    "Routes": {
      "chatroute": {
        "ClusterId": "chatcluster",
        "Match": {
          "Path": "/api/chat/{**catch-all}"
        }
      },
      "documentroute": {
        "ClusterId": "documentcluster",
        "Match": {
          "Path": "/api/document/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "chatcluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7125/"
          }
        }
      },
      "documentcluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7187/"
          }
        }
      }
    }
  }
}